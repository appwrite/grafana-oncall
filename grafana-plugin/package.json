{
  "name": "grafana-oncall-app",
  "version": "1.9.28",
  "packageManager": "pnpm@12.0.0",
  "description": "Grafana OnCall Plugin",
  "scripts": {
    "lint": "oxlint --max-warnings=20 ./src ./e2e-tests",
    "lint:fix": "oxlint --fix --max-warnings=20 ./src ./e2e-tests",
    "format": "oxfmt --write \"**/*.{css,js,json,jsonc,jsx,scss,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{css,js,json,jsonc,jsx,scss,ts,tsx}\"",
    "stylelint": "stylelint ./src/**/*.{css,scss,module.css,module.scss}",
    "stylelint:fix": "stylelint --fix ./src/**/*.{css,scss,module.css,module.scss}",
    "build": "rsbuild build --config-loader jiti --mode production",
    "build:dev": "rsbuild build --config-loader jiti --mode development",
    "labels:link": "pnpm --dir ../../gops-labels/frontend link && pnpm link \"@grafana/labels\" && pnpm --dir ../../gops-labels/frontend watch",
    "labels:unlink": "pnpm --dir ../../gops-labels/frontend unlink",
    "mage:build-dev": "mage -v build:debug",
    "mage:watch": "mage -v watch",
    "test-utc": "TZ=UTC jest --verbose --testNamePattern '^((?!@london-tz).)*$'",
    "test-london-tz": "TZ=Europe/London jest --verbose --testNamePattern '@london-tz'",
    "test": "PLUGIN_ID=grafana-oncall-app pnpm test-utc && pnpm test-london-tz",
    "test:ci": "PLUGIN_ID=grafana-oncall-app pnpm test-utc && pnpm test-london-tz",
    "test:report": "HTML_REPORT_ENABLED=true pnpm test",
    "test:silent": "pnpm test --silent",
    "test:e2e": "PLUGIN_ID=grafana-oncall-app pnpm playwright test --grep-invert @expensive",
    "test:e2e-expensive": "PLUGIN_ID=grafana-oncall-app pnpm playwright test --grep @expensive",
    "test:e2e:watch": "pnpm test:e2e --ui",
    "test:e2e-expensive:watch": "pnpm test:e2e-expensive --ui",
    "test:e2e:gen": "pnpm playwright codegen http://localhost:3000",
    "e2e-show-report": "pnpm playwright show-report --port 31000",
    "generate-types": "cd ./src/network/oncall-api/types-generator && pnpm generate",
    "dev": "rsbuild build --config-loader jiti --watch --mode development",
    "serve": "serve -p 3001 ./dist",
    "dev:serve": "concurrently --names \"serve,dev\" --prefix-colors \"blue,green\" \"pnpm serve\" \"pnpm dev\"",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "pnpm dev",
    "setversion": "setversion",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "type-check:watch": "pnpm type-check --watch --preserveWatchOutput false",
    "find-dead-code": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafana/oncall.git"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@grafana/plugin-e2e": "3.11.1",
    "@grafana/tsconfig": "^2.2.0",
    "@jest/globals": "30.5.0",
    "@playwright/test": "1.62.1",
    "@rsbuild/core": "2.2.1",
    "@rsbuild/plugin-react": "2.1.0",
    "@swc/core": "1.16.1",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.31",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "@types/react-dom": "18.3.7",
    "@types/react-responsive": "^8.0.5",
    "@types/react-test-renderer": "^18.0.5",
    "@types/throttle-debounce": "^5.0.0",
    "dompurify": "^3.4.14",
    "express": "^4.21.2",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "jest-html-reporters": "^3.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^16.4.0",
    "lodash-es": "^4.17.21",
    "mailslurp-client": "^17.4.0",
    "moment-timezone": "0.6.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-test-renderer": "18.3.1",
    "semver": "^7.8.5",
    "serve": "^14.2.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "@emotion/css": "11.10.6",
    "@grafana/data": "12.4.8",
    "@grafana/faro-web-sdk": "^1.19.0",
    "@grafana/faro-web-tracing": "^1.19.0",
    "@grafana/labels": "1.6.13",
    "@grafana/runtime": "12.4.8",
    "@grafana/scenes": "6.57.2",
    "@grafana/schema": "12.4.8",
    "@grafana/ui": "12.4.8",
    "@lifeomic/attempt": "^3.0.3",
    "axios": "^1.18.0",
    "change-case": "^4.1.1",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.5",
    "immutability-helper": "^3.1.1",
    "linkify-react": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "mobx": "6.12.0",
    "mobx-react": "9.1.0",
    "object-hash": "^3.0.0",
    "openapi-fetch": "^0.8.1",
    "qrcode.react": "^3.1.0",
    "query-string": "^7.1.1",
    "rc-table": "^7.17.1",
    "react": "18.3.1",
    "react-copy-to-clipboard": "^5.0.2",
    "react-dom": "18.3.1",
    "react-draggable": "^4.7.1",
    "react-emoji-render": "^1.2.4",
    "react-hook-form": "^7.50.1",
    "react-modal": "^3.15.1",
    "react-responsive": "^8.1.0",
    "react-router-dom-v5-compat": "6.30.6",
    "react-router-dom": "6.30.6",
    "react-string-replace": "^0.4.4",
    "react-use": "^17.4.0",
    "throttle-debounce": "^2.1.0",
    "tinycolor2": "^1.6.0",
    "tslib": "2.5.3"
  }
}

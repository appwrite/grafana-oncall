{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": ["eslint", "typescript", "react", "import", "promise"],
  "env": {
    "browser": true,
    "es2022": true,
    "jest": true,
    "node": true
  },
  "ignorePatterns": ["src/assets", "src/network/oncall-api/autogenerated-api.types.d.ts"],
  "options": {
    "maxWarnings": 20
  },
  "settings": {
    "react": {
      "version": "18.2.0"
    }
  },
  "rules": {
    "curly": "error",
    "eqeqeq": ["warn", "always", { "null": "ignore" }],
    "no-caller": "error",
    "no-cond-assign": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-eval": "error",
    "no-new-wrappers": "error",
    "no-redeclare": "off",
    "no-restricted-imports": "warn",
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "no-unused-labels": "error",
    "no-unused-vars": [
      "warn",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "caughtErrors": "none",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "vars": "all"
      }
    ],
    "no-var": "error",
    "promise/prefer-await-to-then": "error",
    "radix": "error",
    "react/display-name": "warn",
    "react/exhaustive-deps": "off",
    "react/jsx-key": "warn",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "warn",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "off",
    "react/no-unknown-property": "error",
    "react/react-in-jsx-scope": "error",
    "react/require-render-return": "error",
    "react/rules-of-hooks": "error",
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/consistent-type-assertions": "error",
    "typescript/explicit-member-accessibility": "off",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": ["error", { "allowDeclarations": false }],
    "typescript/triple-slash-reference": "error",
    "use-isnan": "error"
  },
  "overrides": [
    {
      "files": ["e2e-tests/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "import/no-relative-parent-imports": "off",
        "no-console": "off",
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    }
  ]
}
